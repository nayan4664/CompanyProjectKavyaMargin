# Database Configuration
# NOTE: MongoDB is case-sensitive for database names on some platforms (like Windows).
# If you get an error "db already exists with different case", ensure your MONGO_URI 
# matches exactly (e.g., kavyamargin vs kavyaMargin).
MONGO_URI=mongodb://127.0.0.1:27017/kavyamargin
JWT_SECRET=supersecret123
